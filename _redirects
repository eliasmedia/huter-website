# Weiterleitungen der alten Website-Struktur (Django-Seite bis 2026)
# Format: /alt  /neu  Statuscode   – Cloudflare Pages
# Hinweis: /foo.html -> /foo macht Cloudflare Pages automatisch (308).

/haustechnik/     /haustechnik     301
/sanitaer/        /bad-sanitaer    301
/sanitaer         /bad-sanitaer    301
/uber-uns/        /ueber-uns       301
/uber-uns         /ueber-uns       301
/kontakt/         /kontakt         301
/anfrage/         /kontakt         301
/anfrage          /kontakt         301
/impressum/       /impressum       301
/datenschutz/     /datenschutz     301

# Seiten ohne direkte Entsprechung in der neuen Struktur
/news/            /                301
/news             /                301
/presse/          /                301
/presse           /                301
/links/           /ueber-uns       301
/links            /ueber-uns       301

# Alte Medienpfade der Django-Seite
/media/*          /                301

# Eigene Fehlerseite erzwingen. MUSS DIE LETZTE REGEL BLEIBEN.
# Grund: Pages macht aus 404.html automatisch die saubere Route /404 und
# verwendet die Datei dadurch nicht mehr als Fehlerdokument – echte 404er
# kamen mit leerem Body zurück. Status 404 = Rewrite, kein Redirect:
# die angefragte URL bleibt stehen, der Statuscode bleibt 404.
# Regeln werden der Reihe nach geprüft und greifen nur, wenn kein
# statisches Asset passt – vorhandene Seiten sind also nicht betroffen.
/*                /404.html        404
