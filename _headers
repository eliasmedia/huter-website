# Cloudflare Pages – HTTP-Header
#
# CSP-Hinweise:
#  - style-src braucht 'unsafe-inline': die Seiten nutzen viele style=""-Attribute
#    und das <noscript><style>. Ohne diese Freigabe bricht das Layout.
#  - script-src bleibt bewusst STRIKT ('self'): es gibt keine Inline-Skripte.
#    Falls je eines dazukommt, hier per sha256-Hash freigeben – nicht 'unsafe-inline'.
#  - cloudflareinsights.com ist vorab freigegeben, damit Cloudflare Web Analytics
#    nach dem Aktivieren im Dashboard sofort funktioniert (siehe README).
#  - frame-src erlaubt nur die OpenStreetMap-Karte auf /kontakt.
#  - form-action erlaubt nur Formspree (Kontaktformular).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; frame-src https://www.openstreetmap.org; form-action 'self' https://formspree.io

# Schriften ändern sich nie – lange cachen.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# CSS/JS sind über ?v=N versioniert – die URL ändert sich bei jeder Änderung.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# Bilder werden unter GLEICHEM Dateinamen ausgetauscht (siehe README),
# darum bewusst nur eine Woche – sonst sehen Besucher wochenlang das alte Bild.
/assets/img/*
  Cache-Control: public, max-age=604800
/assets/logo/*
  Cache-Control: public, max-age=604800
